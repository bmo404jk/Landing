import:
  excel:
    # Маппинг колонок Excel на поля Test IT
    mapping:
      name: "Номер"               # Название тест-кейса (можно использовать номер)
      description: "Пошаговое описание"  # Описание шагов
      expected_result: "Ожидаемый результат"  # Ожидаемый результат
      comment: "Комментарий"       # Доп. комментарии (если нужно)
      
    # Настройки для шагов (если "Пошаговое описание" и "Ожидаемый результат" — это шаги)
    steps:
      step_action: "Пошаговое описание"  # Действие
      step_result: "Ожидаемый результат" # Результат